---
import type { NewsItem } from '../lib/data';
import { formatClock, formatRelativeTime, CATEGORY_LABELS } from '../lib/data';

export interface Props {
  item: NewsItem;
  timeMode?: 'relative' | 'clock';
}
const { item, timeMode = 'relative' } = Astro.props as Props;
const timeText = timeMode === 'clock' ? formatClock(item.published_at) : formatRelativeTime(item.published_at);
const catClass = item.category === 'finance' ? 'cat-finance' : 'cat-tech';
---
<article class="card">
  <div class="meta">
    <span class={`badge ${catClass}`}>{CATEGORY_LABELS[item.category] ?? item.category}</span>
    <span class="source">{item.source_name}</span>
    <span class="dot">·</span>
    <time datetime={item.published_at}>{timeText}</time>
  </div>
  <h2><a href={item.link} target="_blank" rel="noopener noreferrer">{item.title}</a></h2>
  {item.summary && <p class="summary">{item.summary}</p>}
</article>

<style>
  .card {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 10px;
    background: var(--card-bg);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--accent);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      transform: translateY(-1px);
    }
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .dot { margin: 0 6px; }
  .badge {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .cat-tech {
    color: #1d4ed8;
    background: rgba(37, 99, 235, 0.12);
  }
  .cat-finance {
    color: #b45309;
    background: rgba(217, 119, 6, 0.14);
  }
  h2 {
    font-size: 1.02rem;
    margin: 0 0 6px;
    line-height: 1.45;
    font-weight: 600;
  }
  h2 a {
    color: var(--fg);
    text-decoration: none;
  }
  h2 a:hover { color: var(--accent); }
  .summary {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-color-scheme: dark) {
    .cat-tech {
      color: #93c5fd;
      background: rgba(96, 165, 250, 0.16);
    }
    .cat-finance {
      color: #fcd34d;
      background: rgba(251, 191, 36, 0.14);
    }
  }

  @media (hover: hover) and (prefers-color-scheme: dark) {
    .card:hover {
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
    }
  }

  @media (max-width: 640px) {
    .card {
      padding: 12px 14px;
      border-radius: 10px;
    }
    h2 {
      font-size: 0.97rem;
    }
    .summary {
      font-size: 0.85rem;
      -webkit-line-clamp: 2;
    }
  }
</style>
