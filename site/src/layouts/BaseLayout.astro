---
export interface Props {
  title: string;
}
const { title } = Astro.props as Props;

// 网站标题旁的 GitHub 仓库链接；可用 PUBLIC_GITHUB_REPO 环境变量覆盖（便于复刻项目）
const GITHUB_REPO = import.meta.env.PUBLIC_GITHUB_REPO || 'https://github.com/cloudzun/news-site';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="科技/IT与相关财经新闻自动聚合站，每小时更新，数据来源为公开免费RSS。" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={import.meta.env.BASE_URL}>
          <span class="brand-dot" aria-hidden="true"></span>
          科技新闻速览
        </a>
        <a class="repo-link" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap">
      <p>
        本站为个人自动聚合项目，内容版权归原作者/媒体所有，点击标题跳转原文阅读。
        数据每小时由 GitHub Actions 自动抓取公开 RSS 源更新。
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --fg: #1a1a1a;
    --bg: #ffffff;
    --muted: #666;
    --border: #e5e5e5;
    --accent: #2563eb;
    --card-bg: #ffffff;
    --header-bg: rgba(255, 255, 255, 0.85);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #e5e5e5;
      --bg: #0f0f10;
      --muted: #999;
      --border: #2a2a2a;
      --accent: #60a5fa;
      --card-bg: #161618;
      --header-bg: rgba(15, 15, 16, 0.85);
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.6;
  }
  .wrap {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 max(16px, env(safe-area-inset-left)) 0 max(16px, env(safe-area-inset-right));
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    height: 52px;
    display: flex;
    align-items: center;
  }
  .site-header .wrap {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .repo-link {
    flex: 0 0 auto;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.82rem;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  @media (hover: hover) {
    .repo-link:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }
  main { padding: 24px 16px 40px; }
  footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
    padding: 24px max(16px, env(safe-area-inset-left)) 24px max(16px, env(safe-area-inset-right));
    text-align: center;
  }

  @media (max-width: 640px) {
    main { padding-top: 16px; }
    .brand { font-size: 1.05rem; }
  }
</style>
